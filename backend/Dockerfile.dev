FROM node:22-alpine AS development

RUN apk update && apk add --no-cache \
    libreoffice \
    ttf-dejavu \
    ttf-droid \
    ttf-freefont \
    ttf-liberation \
    fontconfig

RUN fc-cache -f

WORKDIR /app

COPY package.json tsconfig.json tsconfig.build.json yarn.lock /app/

RUN yarn install

COPY ./prisma /app/prisma
COPY ./src /app/src

EXPOSE 3000

CMD ["yarn", "backend:start:dev"]

