generator client {
  provider = "prisma-client"
  output   = "./generated/prisma/client"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id                Int       @id @default(autoincrement())
  avatar            String    @default("default-avatar.png")
  name              String    @db.VarChar(60)
  surname           String    @db.VarChar(60)
  email             String    @unique
  password          String
  resetPasswordLink String?   @unique
  role              Role      @default(USER)
  isActivated       Boolean   @default(false)
  activatedLink     String?   @unique
  updated_at        DateTime  @updatedAt
  created_at        DateTime  @default(now())
  posts             Post[]
  token             Token[]
  comments          Comment[]

  @@map("users")
}

model Token {
  id         Int      @id @default(autoincrement())
  token      String   @unique
  updated_at DateTime @updatedAt
  created_at DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
  userId     Int      @unique

  @@map("tokens")
}

model Post {
  id          Int      @id @default(autoincrement())
  title       String   @db.VarChar(10000)
  description String   @db.VarChar(10000)
  views       Int      @default(0)
  edited      Boolean  @default(false)
  purchase    Int      @default(0)
  updated_at  DateTime @updatedAt
  created_at  DateTime @default(now())

  user   User @relation(fields: [userId], references: [id])
  userId Int

  presentation Presentation?
  post_images  Post_images[]
  comments     Comment[]

  @@map("posts")
}

model Post_images {
  id         Int      @id @default(autoincrement())
  name       String   @unique
  updated_at DateTime @updatedAt
  created_at DateTime @default(now())

  post   Post @relation(fields: [postId], references: [id])
  postId Int

  @@map("post_images")
}

model Presentation {
  id         Int      @id @default(autoincrement())
  name       String   @unique
  weight     Int      @default(0)
  sales      Int      @default(0)
  updated_at DateTime @updatedAt
  created_at DateTime @default(now())
  post       Post     @relation(fields: [postId], references: [id])
  postId     Int      @unique

  @@map("product_presentations")
}

model Comment {
  id         Int      @id @default(autoincrement())
  text       String   @db.VarChar(255)
  updated_at DateTime @updatedAt
  created_at DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
  userId     Int
  post       Post     @relation(fields: [postId], references: [id])
  postId     Int

  @@map("comments")
}
