{
  "dependencies": {
    "@nestjs/mapped-types": "*"
  },
  "name": "frogo",
  "packageManager": "yarn@4.9.2",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "eslint": "^10.5.0",
    "eslint-plugin-import-x": "^4.16.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0"
  },
  "scripts": {
    "prepare": "husky",
    "docker:backend:prod": "docker compose -f docker-compose.prod.yaml --env-file ./backend/.env.production up",
    "docker:backend:dev": "docker compose -f docker-compose.dev.yaml --env-file ./backend/.env.development up --watch --build"
  },
  "lint-staged": {
    "!(*eslint|.pnp).{config,loader}.{mjs,mts,cjs}": "eslint . --fix"
  }
}
