{
  "dependencies": {
    "@nestjs/mapped-types": "*"
  },
  "name": "frogo",
  "packageManager": "yarn@4.9.2",
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "prepare": "husky",
    "docker:backend:prod": "docker compose -f docker-compose.prod.yaml --env-file ./backend/.env.production up",
    "docker:backend:dev": "docker compose -f docker-compose.dev.yaml --env-file ./backend/.env.development up --watch --build"
  },
  "lint-staged": {
    "!(*eslint|.pnp).{config,loader}.{mjs,mts,cjs}": "eslint . --fix"
  }
}
